pipeline {
    agent any
    tools { nodejs "nodejs" }

    stages {
        stage("Instalar dependencias e subir o servidor") {
            steps {
                dir('exercicio-jenkins-modulo-18') {
                    bat '''
                        call npm install
                        start /B npm start
                    '''
                }
            }
        }

        stage('Executar testes automatizados') {
            steps {
                dir('exercicio-jenkins-modulo-18') {
                    bat 'npx cypress run'
                }
            }
        }
    }

    post {
        always {
            dir('exercicio-jenkins-modulo-18') {
                bat 'npx allure generate allure-results --clean -o allure-report || exit 0'
                archiveArtifacts artifacts: 'cypress/screenshots/**/*.*,cypress/videos/**/*.*,allure-report/**/*.*', allowEmptyArchive: true
            }
            bat 'taskkill /F /IM node.exe || exit 0'
        }
    }
}