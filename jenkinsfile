pipeline {
    agent any
    tools { nodejs "nodejs" }

    stages {
        stage("Clonar o projeto de testes") {
            steps {
                bat 'if exist exercicio-jenkins-modulo-18 rmdir /s /q exercicio-jenkins-modulo-18'
                bat 'git clone https://github.com/Pesseguini/exercicio-jenkins-modulo-18.git'
            }
        }

        stage("Subir o servidor da aplicação") {
            steps {
                bat 'if exist cypress-hub-de-leitura rmdir /s /q cypress-hub-de-leitura'
                bat 'git clone https://github.com/Pesseguini/cypress-hub-de-leitura.git'
                dir('cypress-hub-de-leitura') {
                    bat 'call npm install'
                    bat 'call npm run db'
                    bat 'start /B npm start'
                }
            }
        }

        stage('Executar testes automatizados') {
            steps {
                dir('exercicio-jenkins-modulo-18') {
                    bat 'call npm install'
                    bat 'call npx cypress run'
                }
            }
        }
    }

    post {
        always {
            dir('exercicio-jenkins-modulo-18') {
                archiveArtifacts artifacts: 'cypress/screenshots/**/*.*,cypress/videos/**/*.*', allowEmptyArchive: true
            }
        }
    }
}